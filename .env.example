# =============================================================
# Copy this file to ".env" and fill in values. Never commit .env.
# Only the variables marked "required by bridge.py" are needed for
# GroupMe I/O; GITHUB_TOKEN is only used on first container start.
# =============================================================

# ---- GitHub CLI (optional, used on first boot) ----
GITHUB_TOKEN=

# ---- GroupMe outbound notification ----
GROUPME_BOT_ID=
GROUPME_ALLOWED_GROUP_ID=
GROUPME_ALLOWED_USER_ID=
